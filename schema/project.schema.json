{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/lumenods/allupdsw/main/schema/project.schema.json",
  "title": "allupdsw: файл версий проекта",
  "type": "object",
  "required": ["project", "repository", "latest", "update_commands", "versions"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "project": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$",
      "description": "Имя проекта, совпадает с именем файла без .json"
    },
    "title": { "type": "string", "description": "Человекочитаемое название" },
    "repository": { "type": "string", "format": "uri", "description": "Репозиторий проекта" },
    "latest": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Последняя версия, равна versions[0].version"
    },
    "update_commands": {
      "type": "object",
      "description": "Команды обновления по способу установки (linux, docker, windows ...)",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "string" }
      }
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "description": "История версий, от новой к старой",
      "items": {
        "type": "object",
        "required": ["version", "date", "type", "changes"],
        "additionalProperties": false,
        "properties": {
          "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "type": { "enum": ["initial", "patch", "minor", "major"] },
          "changes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "breaking": { "type": "boolean", "default": false },
          "security": { "type": "boolean", "default": false, "description": "Исправления безопасности — обновление рекомендуется срочно" },
          "min_upgrade_from": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
          "update_commands": {
            "type": "object",
            "description": "Особые команды именно для этой версии (переопределяют общие)",
            "additionalProperties": { "type": "array", "items": { "type": "string" } }
          }
        }
      }
    }
  }
}
